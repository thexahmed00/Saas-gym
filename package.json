{
  "name": "saas-gym",
  "private": true,
  "version": "0.1.0",
  "description": "Gym management system for IronTrack",
  "author": "IronTrack",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
